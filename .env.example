# Local: call the API directly. Production (www): use same-origin proxy to avoid CORS (see API_PROXY_TARGET).
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Production (required for Next rewrite; browser auto-uses /api-proxy on bluetopvilla.com even if unset):
# NEXT_PUBLIC_API_URL=/api-proxy
# API_PROXY_TARGET=https://api.bluetopvilla.com/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only needed if uploaded photos are served from a different host than the API (e.g. a CDN).
NEXT_PUBLIC_MEDIA_URL=
